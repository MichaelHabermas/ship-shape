{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",
    "baseUrl": ".",
    "paths": {
      "@ship/shared": ["../shared/dist"],
      "@ship/shared/*": ["../shared/dist/*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["src/test/**/*", "src/**/__tests__/**/*", "src/**/*.test.ts", "src/**/*.spec.ts"]
}
