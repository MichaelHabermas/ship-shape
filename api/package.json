{
  "name": "@ship/api",
  "version": "0.0.0",
  "private": true,
  "description": "Express API server",
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "rm -rf dist && tsc && cp src/db/schema.sql dist/db/schema.sql && cp -r src/db/migrations dist/db/migrations",
    "start": "node dist/index.js",
    "clean": "rm -rf dist",
    "type-check": "pnpm --filter @ship/shared build && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "db:seed": "tsx src/db/seed.ts",
    "db:migrate": "tsx src/db/migrate.ts",
    "search:reindex": "tsx src/scripts/reindex-search.ts",
    "fleetgraph:detector": "tsx src/scripts/fleetgraph-detector.ts",
    "fleetgraph:demo": "tsx src/scripts/fleetgraph-demo.ts",
    "fleetgraph:eval:surface": "tsx src/scripts/fleetgraph-product-surface-eval.ts",
    "db:orphan-check": "tsx src/db/scripts/orphan-diagnostic.ts",
    "openapi:generate": "tsx src/scripts/generate-openapi.ts",
    "mcp": "tsx src/mcp/server.ts",
    "trace:smoke": "tsx src/scripts/trace-smoke.ts"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "7",
    "@aws-sdk/client-bedrock-runtime": "^3.1051.0",
    "@aws-sdk/client-s3": "^3.1051.0",
    "@aws-sdk/client-secrets-manager": "^3.1051.0",
    "@aws-sdk/client-ssm": "^3.1051.0",
    "@aws-sdk/s3-request-presigner": "^3.1051.0",
    "@langchain/langgraph": "^1.3.2",
    "@langchain/openai": "^1.4.7",
    "@langfuse/client": "^5.4.0",
    "@langfuse/otel": "^5.4.0",
    "@langfuse/tracing": "^5.4.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@opentelemetry/sdk-node": "^0.218.0",
    "@ship/shared": "workspace:*",
    "bcryptjs": "^3.0.3",
    "cookie": "^1.1.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "csrf-sync": "^4.2.1",
    "dotenv": "^17.4.2",
    "express": "^4.22.2",
    "express-rate-limit": "^8.5.2",
    "express-session": "^1.19.0",
    "helmet": "^8.0.0",
    "langchain": "^1.4.2",
    "langsmith": "^0.7.2",
    "lib0": "^0.2.99",
    "openid-client": "^6.8.4",
    "pg": "^8.21.0",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^11.1.1",
    "ws": "^8.20.1",
    "y-protocols": "^1.0.7",
    "y-websocket": "^2.0.4",
    "yjs": "^13.6.30",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/cookie": "^1.0.0",
    "@types/cookie-parser": "^1.4.8",
    "@types/cookiejar": "^2.1.5",
    "@types/cors": "^2.8.17",
    "@types/docker-modem": "^3.0.6",
    "@types/dockerode": "^4.0.1",
    "@types/express": "^5.0.0",
    "@types/express-session": "^1.19.0",
    "@types/methods": "^1.1.4",
    "@types/node": "^22.19.3",
    "@types/pg": "^8.20.0",
    "@types/ssh2": "^1.15.5",
    "@types/superagent": "^8.1.10",
    "@types/supertest": "^7.2.0",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/ws": "^8.5.13",
    "@vitest/ui": "^4.1.7",
    "openapi3-ts": "^4.5.0",
    "supertest": "^7.1.4",
    "tsx": "^4.22.3",
    "typescript": "^5.7.2",
    "vitest": "^4.1.7"
  }
}
