{
  "name": "ship",
  "version": "0.0.0",
  "private": true,
  "description": "Ship monorepo - API + Web + Shared types",
  "packageManager": "pnpm@10.27.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "./scripts/dev.sh",
    "dev:any-port": "SHIP_DEV_ANY_PORT=1 ./scripts/dev.sh",
    "dev:where": "node ./scripts/dev-where.mjs",
    "dev:open": "node ./scripts/dev-where.mjs --open",
    "docker:up": "docker compose -f docker-compose.local.yml up --build",
    "docker:down": "docker compose -f docker-compose.local.yml down",
    "docker:clean": "docker compose -f docker-compose.local.yml down -v",
    "dev:raw": "pnpm --parallel --recursive run dev",
    "dev:api": "pnpm --filter @ship/api dev",
    "dev:web": "pnpm --filter @ship/web dev",
    "dev:shared": "pnpm --filter @ship/shared dev",
    "build": "pnpm --recursive run build",
    "build:shared": "pnpm --filter @ship/shared build",
    "build:api": "pnpm run build:shared && pnpm --filter @ship/sdk build && pnpm --filter @ship/api build",
    "build:web": "pnpm run build:shared && pnpm --filter @ship/web build",
    "type-check": "pnpm --recursive run type-check && tsc --noEmit -p e2e/tsconfig.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "check:affected-ts": "node ./scripts/check-affected-ts.mjs",
    "openapi:generate": "pnpm --filter @ship/api openapi:generate && pnpm --filter @ship/api public-openapi:generate && pnpm exec openapi-typescript api/openapi.json -o web/src/api/generated/ship-openapi.d.ts && node ./scripts/check-openapi-types.mjs",
    "openapi:check": "node ./scripts/check-openapi-routes.mjs",
    "openapi:check:strict": "node ./scripts/check-openapi-routes.mjs --strict",
    "docs:check": "node ./scripts/doc-sync/check.mjs",
    "docs:check:strict": "node ./scripts/doc-sync/check.mjs --strict",
    "docs:check:fleetgraph-chat": "node ./scripts/check-fleetgraph-chat-contract.mjs",
    "docs:facts:render": "node ./scripts/doc-sync/render-fact-blocks.mjs",
    "drill": "node ./scripts/drill.mjs",
    "plugforge:verify": "./scripts/ci/plugforge-verify.sh",
    "plugforge:oauth-e2e": "./scripts/ci/plugforge-oauth-e2e.sh",
    "clean": "pnpm --recursive run clean && rm -rf node_modules",
    "test": "pnpm test:api",
    "test:api": "./scripts/run-api-tests.sh",
    "test:all": "./scripts/run-all-tests.sh",
    "test:e2e": "./scripts/e2e-guidance.sh",
    "test:e2e:raw": "playwright test",
    "test:e2e:setup": "playwright install chromium",
    "test:e2e:run": "./scripts/run-e2e-profiled.sh",
    "test:e2e:shards": "./scripts/run-e2e-shards.sh",
    "test:e2e:smoke": "./scripts/run-e2e.sh e2e/auth.spec.ts e2e/docs-mode.spec.ts e2e/issues.spec.ts e2e/fleetgraph-chat.spec.ts",
    "test:e2e:ui": "playwright test --ui",
    "a11y:closeout": "node ./scripts/a11y-closeout.mjs",
    "a11y:closeout:local": "node ./scripts/a11y-closeout-local.mjs",
    "security:probe": "pnpm exec shipshape-security run",
    "security:probe:deployed": "./scripts/security-probe/run-deployed-probe.sh",
    "security:probe:ci": "pnpm exec shipshape-security ci",
    "security:console": "node ./packages/shipshape-security/src/console/server.mjs",
    "submission:validate": "node ./scripts/submission/validate-ledger.mjs",
    "submission:render": "pnpm submission:validate && node ./scripts/submission/render-dashboard.mjs && node ./scripts/submission/render-markdown-sections.mjs && node ./scripts/submission/render-evidence-bundle.mjs",
    "submission:check": "node ./scripts/submission/check-generated.mjs && node ./scripts/submission/check-evidence-bundle.mjs",
    "submission:test": "node --test ./scripts/submission/submission-pipeline.test.mjs",
    "worktree:init": "./scripts/worktree-init.sh",
    "branches:sync": "bash ./scripts/sync-feature-branches.sh",
    "db:seed": "pnpm --filter @ship/api db:seed",
    "db:migrate": "pnpm --filter @ship/api db:migrate",
    "db:orphan-check": "pnpm --filter @ship/api db:orphan-check",
    "fleetgraph:detector": "pnpm --filter @ship/api fleetgraph:detector",
    "fleetgraph:demo": "pnpm --filter @ship/api fleetgraph:demo",
    "fleetgraph:observe": "node ./scripts/run-fleetgraph-observe.mjs",
    "fleetgraph:observe:sync": "pnpm --filter @ship/api fleetgraph:observe:sync",
    "fleetgraph:observe:dashboard": "node ./scripts/render-fleetgraph-observability-dashboard.mjs",
    "fleetgraph:proof": "node ./scripts/fleetgraph-proof/run.mjs",
    "fleetgraph:proof:check": "node ./scripts/fleetgraph-proof/check.mjs",
    "fleetgraph:proof:verify-traces": "node ./scripts/fleetgraph-proof/verify-public-traces.mjs",
    "fleetgraph:proof:ci": "pnpm fleetgraph:proof:test && pnpm fleetgraph:proof -- --mode local --with-e2e && pnpm fleetgraph:proof:check",
    "fleetgraph:proof:test": "node --test ./scripts/fleetgraph-proof/*.test.mjs",
    "trace:smoke": "pnpm --filter @ship/api trace:smoke",
    "prepare": "husky",
    "postinstall": "git config merge.ours.driver true && (command -v comply >/dev/null 2>&1 || echo '\\n⚠️  comply CLI not installed - pre-commit hooks require it\\n   Install with: pip install comply-cli\\n')"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@playwright/test": "^1.60.0",
    "@ship/shared": "workspace:*",
    "@ship/shipshape-security": "workspace:*",
    "@testcontainers/postgresql": "^12.0.0",
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^22.19.5",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^7.2.0",
    "@vitest/ui": "^4.1.7",
    "bcryptjs": "^3.0.3",
    "eslint": "^10.4.0",
    "eslint-plugin-import-x": "^4.16.2",
    "get-port": "^7.2.0",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.8.3",
    "supertest": "^7.1.4",
    "testcontainers": "^12.0.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.59.4",
    "vitest": "^4.1.7"
  },
  "pnpm": {
    "overrides": {
      "flatted": "3.4.2",
      "jsdom": "27.4.0",
      "markdown-it": "14.1.1",
      "anymatch@3.1.3>picomatch": "2.3.2",
      "micromatch@4.0.8>picomatch": "2.3.2",
      "readdirp@3.6.0>picomatch": "2.3.2",
      "tinyglobby@0.2.15>picomatch": "4.0.4",
      "tinyglobby@0.2.16>picomatch": "4.0.4",
      "vite@6.4.2>picomatch": "4.0.4",
      "vitest@4.1.7>picomatch": "4.0.4",
      "qs": "6.15.2",
      "tmp": "0.2.7",
      "yaml": "2.9.0"
    }
  }
}
