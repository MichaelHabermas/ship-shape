{
  "name": "@ship/sdk",
  "version": "0.0.0",
  "private": true,
  "description": "Public TypeScript SDK for Ship",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc",
    "clean": "rm -rf dist",
    "test": "vitest run src",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@noble/hashes": "^2.2.0"
  },
  "peerDependencies": {
    "@ship/shared": "0.0.0"
  },
  "devDependencies": {
    "@ship/shared": "workspace:*"
  }
}
